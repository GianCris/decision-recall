{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://dr-bench.local/schema/v0.1/scenario.schema.json","title":"DR-Bench v0.1 Decision Recall scenario","type":"object","additionalProperties":false,"required":["schema_version","id","split","domain","title","complexity","candidate","private"],"properties":{"schema_version":{"const":"0.1"},"id":{"type":"string","pattern":"^(dev|holdout)-[0-9]{3}$"},"split":{"enum":["dev","holdout"]},"domain":{"type":"string","minLength":1},"title":{"type":"string","minLength":1},"complexity":{"type":"object","additionalProperties":false,"required":["agent_hops","semantic_distance","information_transformation","boundary"],"properties":{"agent_hops":{"enum":[0,1,2,4]},"semantic_distance":{"enum":["literal","paraphrase","semantic_transformation","conceptual_consequence"]},"information_transformation":{"enum":["copy","summary","compression","inference"]},"boundary":{"enum":["shared","partial_visibility","department","different_authority"]}}},"candidate":{"type":"object","additionalProperties":false,"required":["brief","agents","knowledge_before","change","transmissions","decisions","world","consequences","recovery_actions"],"properties":{"brief":{"type":"string"},"agents":{"type":"array","minItems":2},"knowledge_before":{"type":"array","minItems":1},"change":{"type":"object"},"transmissions":{"type":"array"},"decisions":{"type":"array","minItems":1},"world":{"type":"object"},"consequences":{"type":"array","minItems":2},"recovery_actions":{"type":"array","minItems":1}}},"private":{"type":"object","additionalProperties":false,"required":["hard_negative_types","decision_labels","consequence_labels","recovery"],"properties":{"hard_negative_types":{"type":"array","minItems":1},"decision_labels":{"type":"array","minItems":1},"consequence_labels":{"type":"object"},"recovery":{"type":"object"}}}}}
